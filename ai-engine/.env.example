# AI Engine Environment Variables
# Copy this file to .env and fill in the values

PORT=5000

# Ollama host (default: local Ollama instance)
OLLAMA_HOST=http://localhost:11434

# Ollama model to use (must be pulled first: `ollama pull llama3`)
OLLAMA_MODEL=llama3

# Path to the knowledge-base SOP directory
KNOWLEDGE_BASE_DIR=../knowledge-base/sop
